# 1. a namespace stuck in Terminating

$ kubectl create namespace demo
namespace/demo created
[exit 0]

$ kubectl -n demo create configmap app-config --from-literal=mode=prod
configmap/app-config created
[exit 0]

$ kubectl -n demo patch configmap app-config --type=merge -p '{"metadata":{"finalizers":["example.com/cleanup"]}}'
configmap/app-config patched
[exit 0]

$ kubectl delete namespace demo --wait=false
namespace "demo" deleted
[exit 0]

$ kubectl get namespace demo
NAME   STATUS        AGE
demo   Terminating   10s
[exit 0]

$ kubectl get namespace demo -o jsonpath='{range .status.conditions[*]}{.type}={.status}: {.message}{"\n"}{end}'
NamespaceDeletionDiscoveryFailure=False: All resources successfully discovered
NamespaceDeletionGroupVersionParsingFailure=False: All legacy kube types successfully parsed
NamespaceDeletionContentFailure=False: All content successfully deleted, may be waiting on finalization
NamespaceContentRemaining=True: Some resources are remaining: configmaps. has 1 resource instances
NamespaceFinalizersRemaining=True: Some content in the namespace has finalizers remaining: example.com/cleanup in 1 resource instances
[exit 0]

$ kubectl api-resources --verbs=list --namespaced -o name | xargs -n 1 kubectl get --show-kind --ignore-not-found -n demo
NAME                   DATA   AGE
configmap/app-config   1      11s
Warning: v1 Endpoints is deprecated in v1.33+; use discovery.k8s.io/v1 EndpointSlice
[exit 0]

# without --wait=false, this command waits forever: it timed out our first run

$ kubectl delete namespace demo --force --grace-period=0 --wait=false
Warning: Immediate deletion does not wait for confirmation that the running resource has been terminated. The resource may continue to run on the cluster indefinitely.
namespace "demo" force deleted
[exit 0]

$ kubectl get namespace demo
NAME   STATUS        AGE
demo   Terminating   18s
[exit 0]

$ kubectl -n demo patch configmap app-config --type=json -p '[{"op":"remove","path":"/metadata/finalizers"}]'
configmap/app-config patched
[exit 0]

$ kubectl wait --for=delete namespace/demo --timeout=60s
namespace/demo condition met
[exit 0]

$ kubectl get namespace demo
Error from server (NotFound): namespaces "demo" not found
[exit 1]

$ kubectl get apiservices | awk 'NR == 1 || $3 != "True"'
NAME                              SERVICE   AVAILABLE   AGE
[exit 0]

# the finalize subresource, and what it leaves behind

$ kubectl create namespace demo2
namespace/demo2 created
[exit 0]

$ kubectl -n demo2 create configmap app-config --from-literal=mode=prod
configmap/app-config created
[exit 0]

$ kubectl -n demo2 patch configmap app-config --type=merge -p '{"metadata":{"finalizers":["example.com/cleanup"]}}'
configmap/app-config patched
[exit 0]

$ kubectl delete namespace demo2 --wait=false
namespace "demo2" deleted
[exit 0]

$ kubectl get namespace demo2 -o json | jq '.spec.finalizers = []' | kubectl replace --raw /api/v1/namespaces/demo2/finalize -f - | jq -r '.status.phase'
Terminating
[exit 0]

$ kubectl wait --for=delete namespace/demo2 --timeout=60s
[exit 0]

$ kubectl create namespace demo2
namespace/demo2 created
[exit 0]

$ kubectl -n demo2 get configmap app-config -o jsonpath='{.metadata.finalizers}'
["example.com/cleanup"][exit 0]

$ kubectl -n demo2 patch configmap app-config --type=json -p '[{"op":"remove","path":"/metadata/finalizers"}]'
configmap/app-config patched
[exit 0]

$ kubectl delete namespace demo2
namespace "demo2" deleted
[exit 0]

