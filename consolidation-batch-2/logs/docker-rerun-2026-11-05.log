# 2. attach and detach

# a. a container started with -it: Ctrl+P Ctrl+Q detaches

$ (sleep 2; printf '\x10\x11'; sleep 3) | timeout 8 script -qec 'docker attach shell' /dev/null; echo "[attach exit $?]"; state shell
Error response from daemon: No such container: shell
docker-rerun.sh: line 9: printf: write error: Broken pipe
[attach exit 1]

Error: No such object: shell
[exit 1]

# b. typing exit in the attached shell ends the main process

$ (sleep 2; printf 'exit\r'; sleep 3) | timeout 8 script -qec 'docker attach shell' /dev/null; echo "[attach exit $?]"; state shell
Error response from daemon: No such container: shell
docker-rerun.sh: line 9: printf: write error: Broken pipe
[attach exit 1]

Error: No such object: shell
[exit 1]

# c. custom detach keys

$ (sleep 2; printf '\x18'; sleep 3) | timeout 8 script -qec 'docker attach --detach-keys=ctrl-x shell2' /dev/null; echo "[attach exit $?]"; state shell2
Error response from daemon: No such container: shell2
docker-rerun.sh: line 9: printf: write error: Broken pipe
[attach exit 1]

Error: No such object: shell2
[exit 1]

# d. no -it: Ctrl+P Ctrl+Q is not a detach sequence

$ (sleep 2; printf '\x10\x11'; sleep 3) | timeout 6 script -qec 'docker attach --sig-proxy=false web' /dev/null; echo "[attach exit $?]"; state web
Error response from daemon: No such container: web
docker-rerun.sh: line 9: printf: write error: Broken pipe
[attach exit 1]

Error: No such object: web
[exit 1]

# e. no -it, --sig-proxy=false: Ctrl+C leaves the container running

$ (sleep 2; printf '\x03'; sleep 3) | timeout 8 script -qec 'docker attach --sig-proxy=false web' /dev/null; echo "[attach exit $?]"; sleep 1; state web
Error response from daemon: No such container: web
docker-rerun.sh: line 9: printf: write error: Broken pipe
[attach exit 1]

Error: No such object: web
[exit 1]

# f. no -it, default --sig-proxy=true: Ctrl+C stops the container

$ (sleep 2; printf '\x03'; sleep 3) | timeout 8 script -qec 'docker attach web' /dev/null; echo "[attach exit $?]"; sleep 2; state web
Error response from daemon: No such container: web
docker-rerun.sh: line 9: printf: write error: Broken pipe
[attach exit 1]

Error: No such object: web
[exit 1]

$ docker logs --tail 2 web
Error response from daemon: No such container: web
[exit 1]

# g. killing the attach client (SIGTERM) with the default --sig-proxy=true

$ timeout 4 docker attach web; echo "[attach exit $?]"; sleep 2; state web
Error response from daemon: No such container: web
[attach exit 1]

Error: No such object: web
[exit 1]

$ timeout 4 docker attach --sig-proxy=false web; echo "[attach exit $?]"; sleep 2; state web
Error response from daemon: No such container: web
[attach exit 1]

Error: No such object: web
[exit 1]

# h. exec does not touch the main process

$ docker exec web sh -c 'exit 3'; echo "exec exit $?"; state web
Error response from daemon: No such container: web
exec exit 1

Error: No such object: web
[exit 1]

$ docker top web -o pid,args
Error response from daemon: No such container: web
[exit 1]
