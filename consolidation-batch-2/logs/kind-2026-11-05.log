# decode one key, then all keys

$ kubectl create secret generic db-credentials --from-literal=username=app --from-literal=password='s3cr3t-Pa55'
secret/db-credentials created
[exit 0]

$ kubectl get secret db-credentials -o jsonpath='{.data.password}' | base64 -d; echo
s3cr3t-Pa55
[exit 0]

$ kubectl get secret db-credentials -o go-template='{{range $k, $v := .data}}{{$k}}={{$v | base64decode}}{{"\n"}}{{end}}'
password=s3cr3t-Pa55
username=app
[exit 0]

$ kubectl get secret db-credentials -o json | jq -r '.data | map_values(@base64d)'
{
  "password": "s3cr3t-Pa55",
  "username": "app"
}
[exit 0]

# the trailing newline from echo

$ echo 's3cr3t-Pa55' > password.txt && kubectl create secret generic db-file --from-file=password=password.txt
secret/db-file created
[exit 0]

$ kubectl get secret db-file -o jsonpath='{.data.password}'; echo
czNjcjN0LVBhNTUK
[exit 0]

$ kubectl get secret db-file -o jsonpath='{.data.password}' | base64 -d | od -c
0000000   s   3   c   r   3   t   -   P   a   5   5  \n
0000014
[exit 0]

$ echo 's3cr3t-Pa55' | base64; printf '%s' 's3cr3t-Pa55' | base64
czNjcjN0LVBhNTUK
czNjcjN0LVBhNTU=
[exit 0]

$ printf '%s' 's3cr3t-Pa55' > password.txt && kubectl create secret generic db-file2 --from-file=password=password.txt
secret/db-file2 created
[exit 0]

$ kubectl get secret db-file2 -o jsonpath='{.data.password}' | base64 -d | od -c
0000000   s   3   c   r   3   t   -   P   a   5   5
0000013
[exit 0]

